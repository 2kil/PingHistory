#!/bin/sh /etc/rc.common
# PingHistory OpenWrt 服务脚本（procd）
# 安装：
#   scp dist/PingHistory-linux-arm64 root@<路由器>:/usr/bin/pinghistory
#   scp deploy/openwrt/pinghistory.init root@<路由器>:/etc/init.d/pinghistory
#   ssh root@<路由器> 'chmod +x /usr/bin/pinghistory /etc/init.d/pinghistory'
#   ssh root@<路由器> '/etc/init.d/pinghistory enable && /etc/init.d/pinghistory start'

START=90
STOP=10
USE_PROCD=1

PROG=/usr/bin/pinghistory
DATADIR=/etc/pinghistory

start_service() {
	mkdir -p "$DATADIR"
	procd_open_instance
	# 路由没有桌面环境：关闭托盘与浏览器，监听所有网卡以便局域网访问
	procd_set_param command "$PROG" -data "$DATADIR" -no-tray -no-browser -listen 0.0.0.0
	procd_set_param respawn 3600 5 10
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core="0"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "pinghistory"
}

reload_service() {
	stop
	start
}
